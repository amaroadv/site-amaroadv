---
layout: base.njk
---
<article class="secao secao--estreita artigo">
  <p class="sobretitulo">{{ page.date | dataBR }}</p>
  <h1>{{ title }}</h1>
  {% if autor %}<p class="artigo__autor">{{ autor }}</p>{% endif %}
  <div class="texto">{{ content | safe }}</div>
  <p class="artigo__aviso">Conteúdo de caráter informativo. Não substitui a análise individual de cada caso por advogado.</p>
  <p><a class="link" href="/artigos/">Ver todos os artigos</a></p>
</article>
